# Copy to .env. Every value has a development default, so local dev needs no .env at all.

# --- Core ---
WEB_ORIGIN=http://localhost:5173
API_PORT=4000
WORKER_PORT=4100
PUBLIC_INGEST_URL=ws://localhost:4100/ingest

# 32+ random characters each. Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=
ENCRYPTION_KEY=
INTERNAL_SECRET=

# --- Data ---
# Empty = embedded PGlite under .data/pg (development only).
DATABASE_URL=
DATA_DIR=.data

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# A LiveKit server on the internet (a LiveKit Cloud project), used only by `./run.sh guests`
# so that invited guests on other networks get camera and sound. A normal `./run.sh` ignores
# these and uses the LiveKit on this computer, which spends none of the cloud allowance.
GUEST_LIVEKIT_URL=
GUEST_LIVEKIT_API_KEY=
GUEST_LIVEKIT_API_SECRET=

# relay = host browser -> media worker -> ffmpeg (default)
# livekit = LiveKit Egress renders /render/:id in headless Chrome (production, needs the egress service)
EGRESS_MODE=relay

# --- Optional OAuth apps (one-click connect). Leave empty to hide the button. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Daily AI news rundown ---
# Made every day at 5 PM India time, and from the News tab with "Generate now".
# A key for at least one model is needed for the spoken script; without one the rundown still has
# headlines, summaries and links. NVIDIA is tried first, then Gemini.
NVIDIA_API_KEY=
NEWS_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Used when NEWS_MODEL answers that it is busy.
NEWS_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Whose show it is: read out in the opening and the sign-off. Handles without the @.
SHOW_NAME=AI Daily
SHOW_HOST=Yash Kavaiya
SHOW_X=yashkavaiya
SHOW_GITHUB=Yash-Kavaiya
SHOW_LINKEDIN=yashkavaiya

# --- Docker Compose deployment only (infra/docker-compose.yml) ---
# Public domain of the site, without scheme. LIVEKIT_URL must then be a wss:// address.
PUBLIC_HOST=
POSTGRES_PASSWORD=

# --- Media worker ---
API_INTERNAL_URL=http://localhost:4000
FFMPEG_PATH=ffmpeg
# FFMPEG_LOG=1 prints ffmpeg's full log for each stream.
