# Copy to .env. Every value has a development default, so local dev needs no .env at all.

# --- Core ---
WEB_ORIGIN=http://localhost:5173
API_PORT=4000
WORKER_PORT=4100
PUBLIC_INGEST_URL=ws://localhost:4100/ingest

# 32+ random characters each. Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=
ENCRYPTION_KEY=
INTERNAL_SECRET=

# --- Data ---
# Empty = embedded PGlite under .data/pg (development only).
DATABASE_URL=
DATA_DIR=.data

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# relay = host browser -> media worker -> ffmpeg (default)
# livekit = LiveKit Egress renders /render/:id in headless Chrome (production, needs the egress service)
EGRESS_MODE=relay

# --- Optional OAuth apps (one-click connect). Leave empty to hide the button. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
